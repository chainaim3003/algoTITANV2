# ======================
# TestNet configuration
# For production testing with real blockchain
# ======================

VITE_ENVIRONMENT=testnet

# Algod
VITE_ALGOD_TOKEN=""
VITE_ALGOD_SERVER="https://testnet-api.algonode.cloud"
VITE_ALGOD_PORT=""
VITE_ALGOD_NETWORK="testnet"

# Indexer
VITE_INDEXER_TOKEN=""
VITE_INDEXER_SERVER="https://testnet-idx.algonode.cloud"
VITE_INDEXER_PORT=""

# ======================
# vLEI API Configuration
# For development and production deployments
# ======================

# vLEI API Base URL
# Development: http://localhost:3001
# Production: https://api.yourdomain.com (update when deploying)
VITE_VLEI_API_BASE_URL=http://localhost:3001

# ======================
# V3 Contract Configuration
# For Importer Dashboard and Marketplace functionality
# ======================

# Contract App IDs (must be set after deploying smart contracts)
# ✅ DEPLOYED TO TESTNET - App IDs from deployment
VITE_REGISTRY_APP_ID=745508602
VITE_MARKETPLACE_APP_ID=746657437
VITE_FINANCE_POOL_APP_ID=0
VITE_LENDING_APP_ID=745508591

# Network Configuration (should match VITE_ALGOD_NETWORK above)
VITE_NETWORK=testnet

# Asset Configuration
# TestNet Official USDC Asset ID
VITE_USDC_ASSET_ID=10458941

# Feature Flags
VITE_ENABLE_TRADING=true
VITE_ENABLE_LENDING=true
VITE_ENABLE_POOLS=true
VITE_ENABLE_RISK_SCORING=true







# KMD - Not needed for TestNet
# VITE_KMD_TOKEN=""
# VITE_KMD_SERVER=""
# VITE_KMD_PORT=""
# VITE_KMD_WALLET=""
# VITE_KMD_PASSWORD=""

# ======================
# IPFS Configuration (Optional)
# For production, configure Pinata API credentials
# For development, the app will use mock IPFS hashes
# ======================

# Pinata API credentials (sign up at https://pinata.cloud)
# VITE_PINATA_API_KEY=your_pinata_api_key_here
# VITE_PINATA_SECRET_KEY=your_pinata_secret_key_here
# VITE_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Alternative: Local IPFS node (if running locally)
# VITE_IPFS_NODE_URL=http://localhost:8080/ipfs/


